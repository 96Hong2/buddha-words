{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buddhawords.app/schema/answer-v0.3.json",
  "title": "부처의 말 · 답변 스키마 v0.3",
  "description": "LLM 이 내는 것(LlmPass1·LlmPass2·LlmLight·LlmExtension)과 서버가 조립해 클라이언트에 주는 것(ApiAnswer·ApiLight·ApiInvalid·ApiCrisis·ApiExtension)을 나눈다. LLM 출력에는 경전 본문 필드가 없다. 서버가 id 로 DB 에서 채운다. route 별로 스키마가 다르다. crisis·invalid 를 answer 스키마에 억지로 넣지 않는다.",
  "$defs": {
    "InputRoute": {
      "enum": [
        "light",
        "normal",
        "deep",
        "invalid",
        "crisis",
        "solace"
      ]
    },
    "VisualTheme": {
      "enum": [
        "anxiety",
        "anger",
        "loss",
        "comparison",
        "choice",
        "sleepless",
        "attachment",
        "emptiness",
        "relationship",
        "approval"
      ]
    },
    "EmotionTag": {
      "description": "고정 코드 10종. 화면은 앞에 # 을 붙여 그린다. 모델이 새 태그를 만들면 서버가 other 로 접는다",
      "enum": [
        "anxiety",
        "comparison",
        "approval",
        "attachment",
        "anger",
        "regret",
        "loneliness",
        "emptiness",
        "confusion",
        "fatigue",
        "other"
      ]
    },
    "ContextFlag": {
      "description": "excluded_for 값 집합과 일치해야 한다. 빌드 게이트가 검사한다",
      "enum": [
        "self_harm",
        "abuse_victim",
        "bereavement",
        "discrimination_victim",
        "minor"
      ]
    },
    "ScriptureRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dhp\\.[0-9]{1,3}$"
        }
      }
    },
    "Attribution": {
      "description": "누가 한 말인가. 「불교 문헌의 문장」과 「부처가 직접 한 말」은 다르다. 법구경은 전승상 부처의 가르침이지만 화자가 특정되지 않고, 테리가타·승만경·선어록은 아예 다른 사람이 말한다. 화면은 여기 실린 문자열을 그대로 그리고 화자 이름을 조합하지 않는다",
      "type": "object",
      "required": [
        "displayLabel"
      ],
      "additionalProperties": false,
      "properties": {
        "displayLabel": {
          "type": "string",
          "minLength": 1,
          "description": "「— 오조 홍인, 육조단경 행유품」 · 「부처의 가르침 · 법구경 20장 282게」. 화자가 확정되지 않은 구절은 출처 한 줄이 그대로 들어온다"
        }
      }
    },
    "ScriptureSource": {
      "description": "어느 문헌의 어디를 무슨 언어에서 옮겼나. **문장은 서버가 완성해서 보낸다.** 화면이 원문 언어와 감수 상태를 보고 문장을 지어내면 한문 문헌에 「영역본을 옮겼다」고 적는 일이 다시 생긴다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "description": "저본. 「《육조단경》 행유품 한문 원문」 · 「SuttaCentral 팔리 정본 · Bhikkhu Sujato 영역(CC0) 대조」"
        },
        "license": {
          "type": "string",
          "description": "판본 라이선스를 아직 확인하지 못한 구절에만 온다"
        },
        "translator": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "저본을 어떻게 옮겼고 감수를 받았는지 적은 한 문장. 원문 언어(팔리·한문)와 감수 통과 여부에 따라 서버가 고른다. 감수를 통과하지 않은 구절에는 감수했다는 말이 붙지 않는다"
        },
        "originalLabel": {
          "type": "string",
          "description": "「한문 원문」 · 「팔리 원문」. originalText 가 있을 때만 함께 온다"
        },
        "originalText": {
          "type": "string",
          "description": "팔리·한문 원문. 번역문 전체를 덮는 원문이 실린 구절에만 온다. 공유 카드에는 싣지 않는다(카드 글꼴에 한자가 없다)"
        }
      }
    },
    "Scripture": {
      "description": "서버가 DB 에서 채운다. text 는 사람이 감수한 문장 그대로다",
      "type": "object",
      "required": [
        "id",
        "citation",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "citation": {
          "type": "string",
          "description": "법구경 17장 분노의 장 223게"
        },
        "text": {
          "type": "string"
        },
        "terms": {
          "description": "감수가 붙인 고정 풀이. 한 게송이 낯선 외래 이름을 셋까지 나열하는 일이 있어 3 이다(전단·따가라·말리). 모델이 만드는 LlmPass2.terms 는 2 그대로 둔다",
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "word",
              "gloss"
            ],
            "properties": {
              "word": {
                "type": "string"
              },
              "gloss": {
                "type": "string"
              }
            }
          }
        },
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "description": "화자까지 담은 귀속. 서버는 늘 채워 보낸다. 오지 않으면 화면이 citation 한 줄로 물러선다. 그 방향은 늘 안전한 쪽으로만 틀린다. 조주 선사의 말이 「오등회원」으로 보일 수는 있어도 부처의 말이 되지는 않는다"
        },
        "source": {
          "$ref": "#/$defs/ScriptureSource"
        }
      }
    },
    "AnalysisSection": {
      "type": "object",
      "required": [
        "heading",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24
        },
        "body": {
          "type": "string",
          "minLength": 120,
          "maxLength": 700
        }
      }
    },
    "Action": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 6,
          "maxLength": 40
        },
        "why": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "LlmPass1": {
      "title": "1차 패스 출력 (3~5초). 태그 · 오늘의 부처의 말 · 경전 id · 테마",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "safetyFlag",
        "contextFlags",
        "emotionTags",
        "modernBuddhaMessage",
        "scriptureIds",
        "visualTheme"
      ],
      "properties": {
        "responseType": {
          "enum": [
            "answer",
            "refusal"
          ],
          "description": "첫 필드. refusal 이면 나머지는 비운다"
        },
        "safetyFlag": {
          "enum": [
            "none",
            "concern",
            "crisis"
          ]
        },
        "contextFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextFlag"
          }
        },
        "emotionTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/EmotionTag"
          }
        },
        "modernBuddhaMessage": {
          "type": "string",
          "minLength": 18,
          "maxLength": 70,
          "description": "경구체. 「남의 속도를 좇지 마라. 그 사람의 길은 그 사람의 것이고, 너의 길은 아직 끝나지 않았다.」 화면이 「현대적 풀이」 표시를 붙인다. 부처의 직접 발언처럼 쓰지 않는다"
        },
        "scriptureIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string"
          },
          "description": "후보 목록 안의 id 만. 서버가 화이트리스트로 검증한다"
        },
        "visualTheme": {
          "$ref": "#/$defs/VisualTheme"
        }
      }
    },
    "LlmPass2": {
      "title": "2차 패스 출력 (약 15~20초). 풀이 · 개인화 분석 · 행동 · 마무리",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scriptureExplanation",
        "personalAnalysis",
        "actions",
        "closingMessage"
      ],
      "properties": {
        "scriptureExplanation": {
          "type": "string",
          "minLength": 150,
          "maxLength": 420,
          "description": "해요체. 불교 용어가 나오면 그 자리에서 뜻을 푼다"
        },
        "terms": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "word",
              "gloss"
            ],
            "properties": {
              "word": {
                "type": "string"
              },
              "gloss": {
                "type": "string",
                "maxLength": 80
              }
            }
          },
          "description": "구절의 modern_gloss 에서 나온 말만"
        },
        "personalAnalysis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/AnalysisSection"
          },
          "description": "normal 1개 · deep 2~3개. 상황 구조를 실제로 나눈다. 반복으로 채우지 않는다"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "closingMessage": {
          "type": "string",
          "minLength": 15,
          "maxLength": 60
        }
      }
    },
    "LlmLight": {
      "title": "LIGHT 답변. 한 번에 끝난다. 경전 RAG 없음",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "message"
      ],
      "properties": {
        "responseType": {
          "const": "light"
        },
        "message": {
          "type": "string",
          "minLength": 80,
          "maxLength": 420,
          "description": "250~600자 상한을 서버가 잰다. 불교적 관점을 살짝 재미있게. 이모지 0~1개 허용"
        },
        "emotionTags": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/EmotionTag"
          }
        }
      }
    },
    "LlmExtension": {
      "title": "Deep Extension (보상형 광고 보상). 다른 경전 1 + 다른 관점 1 + 행동 1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scriptureId",
        "alternativeAnalysis",
        "action"
      ],
      "properties": {
        "scriptureId": {
          "type": "string",
          "description": "1차에서 쓰지 않은 후보 중 하나"
        },
        "alternativeAnalysis": {
          "$ref": "#/$defs/AnalysisSection",
          "description": "본 답변과 다른 관점. 같은 말을 길게 반복하지 않는다"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "ApiAnswer": {
      "title": "normal · deep 답변 (조립 후). 화면 7블록 순서와 같다",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "answerId",
        "route",
        "emotionTags",
        "modernBuddhaMessage",
        "scriptures",
        "visualTheme",
        "extensionAvailable",
        "pass2"
      ],
      "properties": {
        "responseType": {
          "const": "answer"
        },
        "answerId": {
          "type": "string"
        },
        "route": {
          "enum": [
            "normal",
            "deep"
          ]
        },
        "routeNote": {
          "enum": [
            "promoted_topic",
            "downgraded_budget"
          ],
          "description": "promoted_topic: 짧게 쓰셨지만 중요한 이야기라 깊게 봤어요. downgraded_budget: 지금은 답변이 몰려서 간단한 풀이로 드렸어요"
        },
        "safety": {
          "enum": [
            "none",
            "concern"
          ]
        },
        "emotionTags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/EmotionTag"
          }
        },
        "modernBuddhaMessage": {
          "type": "string"
        },
        "scriptures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Scripture"
          }
        },
        "visualTheme": {
          "$ref": "#/$defs/VisualTheme"
        },
        "extensionAvailable": {
          "type": "boolean",
          "description": "보상형 광고를 띄울 수 있고(버전·그룹·기기 광고 끄기 아님) 후보 구절이 남아 있을 때만 true"
        },
        "pass2": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "pending"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "failed"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "status",
                "scriptureExplanation",
                "personalAnalysis",
                "actions",
                "closingMessage"
              ],
              "properties": {
                "status": {
                  "const": "done"
                },
                "scriptureExplanation": {
                  "type": "string"
                },
                "terms": {
                  "type": "array"
                },
                "personalAnalysis": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/AnalysisSection"
                  }
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Action"
                  }
                },
                "closingMessage": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "redactedCount": {
          "type": "integer",
          "minimum": 0
        },
        "quota": {
          "$ref": "#/$defs/Quota"
        }
      }
    },
    "ApiLight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "answerId",
        "message",
        "cta"
      ],
      "properties": {
        "responseType": {
          "const": "light"
        },
        "answerId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "emotionTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmotionTag"
          }
        },
        "visualTheme": {
          "const": "choice"
        },
        "cta": {
          "const": "deeper",
          "description": "화면 고정 문구: 조금 더 진지한 고민이 있다면 세 줄 정도 이야기해보세요. 훨씬 깊게 같이 볼 수 있어요"
        },
        "quota": {
          "$ref": "#/$defs/Quota"
        }
      }
    },
    "ApiInvalid": {
      "description": "사용량을 차감하지 않는다. LLM 을 부르지 않는다. 문구는 고정 집합에서 고른다",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "messageKey",
        "retryAllowed"
      ],
      "properties": {
        "responseType": {
          "const": "invalid"
        },
        "messageKey": {
          "enum": [
            "playful",
            "empty",
            "injection",
            "repetition"
          ]
        },
        "retryAllowed": {
          "const": true
        },
        "quota": {
          "$ref": "#/$defs/Quota"
        }
      }
    },
    "ApiCrisis": {
      "description": "경전·풀이·행동·광고 없음. 문구는 클라이언트에 고정돼 있다. 서버는 어떤 창구를 위로 올릴지와 이어서 들을 수 있는 글인지를 준다. 원문은 그대로 클라이언트가 쥐고 있고 서버는 저장하지 않는다",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "channels",
        "crisisLevel",
        "canContinue"
      ],
      "properties": {
        "responseType": {
          "const": "crisis"
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "109",
              "madeleine",
              "1577-0199",
              "1388",
              "1366",
              "112"
            ]
          },
          "description": "위에서부터 그리는 순서. 기본 [109, madeleine]. minor 면 1388, abuse 면 1366·112 추가"
        },
        "flags": {
          "type": "object",
          "properties": {
            "minor": {
              "type": "boolean"
            },
            "abuse": {
              "type": "boolean"
            }
          }
        },
        "crisisLevel": {
          "enum": [
            "acute",
            "distress"
          ],
          "description": "acute 는 방법·수단을 찾거나 준비 행동이 드러난 글. distress 는 고통을 말한 글"
        },
        "canContinue": {
          "type": "boolean",
          "description": "distress 일 때만 true. true 면 화면에 「그래도 이야기를 들어주세요」가 뜬다. acute 는 언제나 false 이고 클라이언트는 이 값을 스스로 뒤집지 않는다"
        }
      }
    },
    "ApiExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseType",
        "answerId",
        "scripture",
        "alternativeAnalysis",
        "action"
      ],
      "properties": {
        "responseType": {
          "const": "extension"
        },
        "answerId": {
          "type": "string"
        },
        "scripture": {
          "$ref": "#/$defs/Scripture"
        },
        "alternativeAnalysis": {
          "$ref": "#/$defs/AnalysisSection"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      }
    },
    "Quota": {
      "description": "이어간 수와 다시 열리는 시각은 사용자 시간대 자정 기준이다. freeUsed 만 다르다: 무료는 사람마다 평생 한 번이라 자정에 안 비워진다(2026-09-22). light·invalid·crisis 는 세지 않는다",
      "type": "object",
      "required": [
        "freeUsed",
        "adContinuesUsed",
        "adContinuesMax",
        "resetsAt"
      ],
      "properties": {
        "freeUsed": {
          "description": "이 사람이 평생 한 번뿐인 첫 이야기를 썼으면 1 이다. 날짜가 바뀌어도 0 으로 안 돌아간다",
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "adContinuesUsed": {
          "type": "integer",
          "minimum": 0
        },
        "adContinuesMax": {
          "description": "이어가기 상한. null 이면 상한이 없다(2026-09-20 하루 천장 폐지). 광고를 본 만큼 이어간다",
          "type": ["integer", "null"]
        },
        "resetsAt": {
          "type": "string",
          "format": "date-time"
