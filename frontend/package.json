{
  "name": "buddha-words-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run check:bundle && ait build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src e2e",
    "e2e": "playwright test",
    "e2e:shots": "playwright test --config playwright.shots.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spec": "node ../tools/check_spec.mjs",
    "check:router": "node --experimental-strip-types ../spec/router.test.ts",
    "verify": "npm run check:spec && npm run check:router && npm run typecheck && npm run e2e",
    "check:bundle": "node ../tools/check_bundle.mjs dist"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.2.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
