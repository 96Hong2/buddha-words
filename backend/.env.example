# backend/.env 의 본보기. 이 파일만 커밋한다. 실제 .env 는 gitignore 대상이다.
#
# 여기서 고를 수 있는 것은 provider 와 키뿐이다.
# **모델 id 와 프롬프트는 배포 산출물이라 환경변수로 갈아 끼우지 않는다**(앱인토스 AI 운영 요건 4번).
# 어떤 모델을 어느 자리에 쓰는지는 app/integrations/llm/openai.py 상수와 MODELS.md 에 있다.

ENVIRONMENT=local
LOG_LEVEL=INFO

# stub | openai
# stub 은 키 없이 돈다. 개발과 e2e 의 기본값이고 같은 글에 늘 같은 답이 나온다.
# openai 로 두고 키를 비우면 조용히 stub 으로 빠지지 않고 기동에서 멈춘다.
LLM_PROVIDER=stub
LLM_API_KEY=

# 운영에서는 반드시 false 다. true 로 두면 아무 문자열로 남의 데이터에 닿는다.
ALLOW_UNVERIFIED_ANON_KEY=true

# 공유 링크(/s/{토큰})를 누른 사람을 넘길 웹 앱 주소. 웹 진입이 따로 있으면 여기에 적는다.
#
# **비워 두면 아무 데로도 넘기지 않고 백엔드 랜딩에 머문다.** 그 화면에는 공유 카드 한 장과
# 토스로 여는 딥링크가 있어 막다른 곳은 아니다. 대신 웹으로 바로 들어가는 버튼이 사라진다.
# 비어 있으면 기동 로그에 web_origin_missing 경고가 한 줄 남는다. 기동을 막지는 않는다.
#
# CORS_ORIGINS 와 섞어 쓰지 않는다. 저쪽은 「이 주소에서 오는 요청을 받는다」는 뜻이고
# 이 값은 「사람을 여기로 보낸다」는 뜻이다. 예전에는 이 값이 비면 CORS 목록의 첫 https
# 주소로 떨어졌는데, 그 값이 토스 미니앱 WebView 주소라 카톡에서 링크를 누른 사람이
# 말없이 그리로 넘어갔다.
#
# http:// 또는 https:// 로 시작하지 않으면 기동에서 멈춘다. 끝의 / 는 있어도 없어도 된다.
# WEB_ORIGIN=https://buddha-words.example.com

# 전역 일일 예산 문. 넘으면 등급을 내리고, 더 넘으면 새 요청을 막는다.
BUDGET_WARN_USD=10.0
BUDGET_BLOCK_USD=20.0

# 재기동을 넘겨야 하는 것이 사는 파일. 지금은 공유 링크(TTL 30일)만 여기 있다.
# 개발은 비워 둔다. 임시 폴더로 떨어지고, 지워져도 잃는 것이 개발용 링크뿐이다.
# **배포에서는 반드시 붙인 볼륨을 가리킨다.** 안 적으면 임시 폴더라 배포·재기동마다 링크가
# 통째로 날아가고, 카톡에 붙은 주소를 누른 사람에게 깨진 화면이 간다.
# WAL 을 켜 두므로 백업은 state.db 하나가 아니라 같은 이름의 -wal · -shm 까지 함께 챙긴다.
# STATE_DB_PATH=/var/lib/buddha-words/state.db

# 저장 자리를 PostgreSQL 로 바꾸는 값. 비워 두면 위의 파일을 쓴다.
# **Cloud Run 에 올릴 때는 반드시 적는다.** 인스턴스 안 파일은 배포·유휴 종료·오토스케일마다
# 사라지고 인스턴스끼리 서로 다른 파일을 본다. 파일로 두면 카톡에 붙은 링크가 배포 한 번에 깨진다.
# 값을 적으면 STATE_DB_PATH 는 쓰이지 않는다. 주소가 postgresql:// 로 시작하지 않으면 기동에서 멈춘다.
# Cloud SQL 은 유닉스 소켓으로 붙는다: postgresql://USER:PW@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
# DATABASE_URL=postgresql://buddha:비밀번호@127.0.0.1:5432/buddha_words

# ─────────────────────────────────────────────────────────────────────────
# 되짚기 알림 (「어제 이야기드린 그거, 해 보셨나요?」)
#
# 알림은 **우리 서버가 보낸다.** 앱이 꺼져 있을 때 가야 해서 기기가 보낼 수 없다.
# 예약은 화면이 `POST /reminder` 로 남기고, 보내는 것은 1분마다 도는
# `scripts/send_reminders.py` 다(Cloud Run 잡 + Cloud Scheduler).
#
# 예약 자리는 DATABASE_URL 을 따라간다. **Cloud Run 에서는 반드시 PostgreSQL 이다.**
# 파일로 두면 인스턴스마다 다른 예약을 보게 되고, 발송 잡은 아무것도 못 찾는다.
# ─────────────────────────────────────────────────────────────────────────

# 콘솔 기능성 캠페인에서 발급받는 템플릿 코드.
# 비어 있으면 발송 잡이 로그 스텁으로 돌고 알림은 실제로 가지 않는다.
# ⚠ **문구 검수 승인 전에는 테스트 발송도 막힌다**(errorCode 5004).
# TOSS_REMINDER_TEMPLATE_SET_CODE=

# 토스 서버 API 를 부를 mTLS 클라이언트 인증서. **파일 경로로만 받는다.**
# 콘솔 → 개발 → mTLS 인증서 → [+ 발급받기] 에서 받는다. 개인키가 내려오므로 사람이 받는다.
# **인증서는 미니앱마다 다르다.** 인증서의 CN 으로 미니앱을 식별해서 다른 앱 것을 못 빌려 쓴다.
# 템플릿 코드는 있는데 이 값이 없으면 발송 잡이 멈춘다(종료 코드 2).
# 조용히 스텁으로 내려가면 배포는 성공으로 보이고 알림만 안 간다.
# TOSS_MTLS_CERT_PATH=/secrets/mtls/public.crt
# TOSS_MTLS_KEY_PATH=/secrets/mtls/private.key

# 기본값 그대로 쓴다. 바꿀 일은 없다.
# TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
